local loginDialog = Dialog(activity, android.R.style.Theme_Material_Dialog_NoActionBar)
loginDialog.setContentView(loadlayout(login_layout))
loginDialog.setCancelable(false)

local window = loginDialog.getWindow()
if window then
  window.setBackgroundDrawable(ColorDrawable(0x00000000))
  window.setDimAmount(0.6)
  window.setSoftInputMode(WindowManager.LayoutParams.SOFT_INPUT_ADJUST_PAN)
  local lp = window.getAttributes()
  lp.width = WindowManager.LayoutParams.MATCH_PARENT
  lp.height = WindowManager.LayoutParams.MATCH_PARENT
  lp.gravity = Gravity.CENTER
  window.setAttributes(lp)
end

loginDialog.show()

loginDialog.setOnKeyListener({
  onKey=function(d, keyCode, event)
    if keyCode == KeyEvent.KEYCODE_BACK then os.exit() return true end
    return false
  end
})

local savedKey = pref.getString("saved_key", "")
if savedKey ~= "" then userKey.setText(savedKey) end

local loadingTimer = nil
local function startLoadingEffect()
  if loadingTimer then
    pcall(function() loadingTimer.stop() end)
    loadingTimer = nil
  end
  local dots = {"", ".", "..", "..."}
  local count = 0
  loginBtn.setBackground(bg(connectingColor, 4))
  loadingTimer = Ticker()
  loadingTimer.Period = 100
  loadingTimer.onTick = function()
    loginBtn.setText("CONNECTING" .. dots[(count % 4) + 1])
    count = count + 1
  end
  loadingTimer.start()
end

loginBtn.onClick=function()
  local inputKey = userKey.Text:gsub("%s+", "")
  if inputKey == "" then
    status.setText("Enter key")
    status.setTextColor(0xFFFF0000)
    status.setVisibility(0)
    shakeAnimation(userKey)
    return
  end

  status.setText("")
  status.setVisibility(8)
  loginBtn.setEnabled(false)
  startLoadingEffect()

  local deviceId = Secure.getString(activity.getContentResolver(), Secure.ANDROID_ID)

  local postData = {
    key = inputKey,
    device_id = deviceId,
    game = targetGame
  }

  Http.post(webPanelURL, postData, "utf-8", nil, function(code, body)
    if loadingTimer then
      pcall(function() loadingTimer.stop() end)
      loadingTimer = nil
    end

    if code == 200 and body then
      local statusVal = tonumber(body:match('"status":%s*(%d+)'))
      local expiryVal = tonumber(body:match('"expiry":%s*(%d+)'))

      if statusVal == 0 and expiryVal then
        local expiryTimestamp = expiryVal

        loginBtn.setText("SUCCESS!")
        loginBtn.setBackground(bg(0xFFD4E056, 4))

        local diff = expiryTimestamp - os.time()
        local dy = math.floor(diff / 86400)
        local hr = math.floor((diff % 86400) / 3600)
        local mn = math.floor((diff % 3600) / 60)

        local durTxt = "Login Success | Valid: " .. dy .. "d " .. hr .. "h " .. mn .. "m"

        status.setText(durTxt)
        status.setTextColor(0xFF00FF00)
        status.setVisibility(0)

        pref.edit().putString("saved_key", inputKey).apply()
        sendToTelegram(inputKey, dy.."d "..hr.."h "..mn.."m")
        startKeyMonitor(expiryTimestamp)
        task(2000, function() loginDialog.dismiss() end)

      elseif statusVal == 1 or statusVal == 4 then
        resetLoginButton()
        status.setText("Key Not Found ! Invalid")
        status.setTextColor(0xFFFF0000)
        status.setVisibility(0)
        shakeAnimation(userKey)

      elseif statusVal == 2 then
        resetLoginButton()
        status.setText("Key Already Used On Another Device")
        status.setTextColor(0xFFFF0000)
        status.setVisibility(0)
        shakeAnimation(userKey)

      elseif statusVal == 3 then
        resetLoginButton()
        status.setText("Key Expired")
        status.setTextColor(0xFFFF0000)
        status.setVisibility(0)
        shakeAnimation(userKey)

      elseif statusVal == 5 then
        resetLoginButton()
        status.setText("Device Blocked")
        status.setTextColor(0xFFFF0000)
        status.setVisibility(0)
        shakeAnimation(userKey)

      else
        resetLoginButton()
        status.setText("Key Not Found ! Invalid")
        status.setTextColor(0xFFFF0000)
        status.setVisibility(0)
        shakeAnimation(userKey)
      end
    else
      resetLoginButton()
      status.setText("Connection Error ! Server Offline")
      status.setTextColor(0xFFFF0000)
      status.setVisibility(0)
      shakeAnimation(userKey)
    end
  end)
end

